# Generated by XcodeGen (`make gen`). Never commit: it causes merge conflicts. project.yml is the source of truth.
*.xcodeproj
*.xcworkspace

# Per-developer signing config
Config/Local.xcconfig

# Build output. NOTE: our Makefile builds into ~/Library/Caches/Waypoint (outside the repo) because
# codesign fails on files inside iCloud-synced ~/Desktop. These entries catch accidental local builds.
build/
DerivedData/
.build/
.swiftpm/
*.xcuserdatad

# macOS
.DS_Store

# Editor / agent local state
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json

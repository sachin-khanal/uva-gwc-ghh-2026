// File:    Config/Base.xcconfig
// Purpose: Shared build defaults + the hook for per-developer overrides.
// Rule:    Do NOT put your own team id here. Copy Config/Local.xcconfig.example to
//          Config/Local.xcconfig (git-ignored) and edit THAT. `make setup` does the copy.

// Defaults so the project still generates/compiles on a machine with no Local.xcconfig.
// Reverse-DNS prefix for every build. GitHub-pages style (io.github.<user>) because we do not own a domain;
// it is only a unique label, nothing contacts it. Final bundle id = $(WAYPOINT_BUNDLE_PREFIX).$(WAYPOINT_DEV_SUFFIX).
WAYPOINT_BUNDLE_PREFIX = io.github.sachin-khanal.waypoint
WAYPOINT_DEV_SUFFIX = shared
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Supabase (public anon key only - never the service_role key). Empty = cloud disabled.
// Real values go in Config/Local.xcconfig. NOTE: in xcconfig "//" starts a comment, so write the URL as
//   SUPABASE_URL = https:/$()/abcdefgh.supabase.co
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Optional include (note the "?"): silently skipped if the file does not exist.
// Values in Local.xcconfig override the defaults above because they are read later.
#include? "Local.xcconfig"
